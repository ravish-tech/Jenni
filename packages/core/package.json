{
  "name": "jenni-core",
  "version": "0.3.0",
  "description": "Jenni (pronounced 'yenni') core layer: OKLCH design tokens, spatial layout, @layer component CSS, and delegated WAI-ARIA behaviors. Built in loving memory of Jenni.",
  "license": "Apache-2.0",
  "author": "Ravish Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravish-tech/Jenni.git",
    "directory": "packages/core"
  },
  "homepage": "https://ravish-tech.github.io/Jenni/",
  "bugs": {
    "url": "https://github.com/ravish-tech/Jenni/issues"
  },
  "keywords": [
    "ui",
    "design-system",
    "css",
    "oklch",
    "container-queries",
    "accessibility",
    "aria"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/jenni.iife.js",
  "jsdelivr": "./dist/jenni.iife.js",
  "style": "./dist/jenni.css",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "manifest.json",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./AGENTS.md": "./AGENTS.md",
    "./css": "./src/index.css",
    "./css/*": "./dist/css/*",
    "./dist/jenni.css": "./dist/jenni.css",
    "./dist/jenni.iife.js": "./dist/jenni.iife.js",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components/*.css": "./src/components/*.css",
    "./components/*": "./src/components/*",
    "./behaviors/*.js": {
      "types": "./dist/behaviors/*.d.ts",
      "default": "./src/behaviors/*.js"
    },
    "./behaviors/*": {
      "types": "./dist/behaviors/*.d.ts",
      "default": "./src/behaviors/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
