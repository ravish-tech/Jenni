{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@jenni/vue": ["../../packages/vue/src/index.ts"],
      "@jenni/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../../packages/*/src/**/*"]
}
